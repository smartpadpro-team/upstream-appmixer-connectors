{
    "name": "appmixer.google.bigquery.QuoteriteToBigQueryPattern",
    "author": "Quoterite Dev <devops@quoterite.com>",
    "description": "Fetch multiple heavy Quoterite lifecycle records and stream them into BigQuery safely via an atomic Load Job pipeline.",
    "quota": {
        "manager": "appmixer:google:bigquery",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "private": false,
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:google",
        "scope": [
            "https://www.googleapis.com/auth/bigquery"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "projectId": { "type": "string" },
                    "datasetId": { "type": "string" },
                    "tableId": { "type": "string" },
                    "client_id": { "type": "string" },
                    "client_secret": { "type": "string" },
                    "ingested_at": { "type": "string" },
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "lifeCycleId": { "type": "string" },
                                "updated_at": { "type": "string" }
                            },
                            "required": ["lifeCycleId"]
                        }
                    }
                },
                "required": [
                    "projectId",
                    "datasetId",
                    "tableId",
                    "client_id",
                    "client_secret",
                    "items"
                ]
            },
            "inspector": {
                "inputs": {
                    "projectId": {
                        "type": "select",
                        "label": "Project ID",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/google/bigquery/ListProjects?outPort=out",
                            "data": {
                                "transform": "./ListProjects#toSelectArray"
                            }
                        }
                    },
                    "datasetId": {
                        "type": "select",
                        "label": "Dataset",
                        "index": 2,
                        "source": {
                            "url": "/component/appmixer/google/bigquery/ListDatasets?outPort=out",
                            "data": {
                                "messages": {
                                    "in/projectId": "inputs/in/projectId"
                                },
                                "transform": "./ListDatasets#toSelectArray"
                            }
                        }
                    },
                    "tableId": {
                        "type": "select",
                        "label": "Table",
                        "index": 3,
                        "source": {
                            "url": "/component/appmixer/google/bigquery/ListTables?outPort=out",
                            "data": {
                                "messages": {
                                    "in/projectId": "inputs/in/projectId",
                                    "in/datasetId": "inputs/in/datasetId"
                                },
                                "transform": "./ListTables#toSelectArray"
                            }
                        }
                    },
                    "client_id": {
                        "type": "text",
                        "label": "Quoterite Client ID",
                        "index": 4
                    },
                    "client_secret": {
                        "type": "text",
                        "label": "Quoterite Client Secret",
                        "index": 5
                    },
                    "items": {
                        "type": "multiselect",
                        "label": "Lifecycle Items Array",
                        "index": 6
                    },
                    "ingested_at": {
                        "type": "text",
                        "label": "Ingested At",
                        "index": 7
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "status": { "type": "string" },
                    "insertedRows": { "type": "number" }
                }
            },
            "options": [
                { "label": "Status", "value": "status" },
                { "label": "Inserted Rows", "value": "insertedRows" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,PHN2ZyBoZWlnaHQ9IjI1MDAiIHdpZHRoABA..."
}