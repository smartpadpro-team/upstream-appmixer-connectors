{
  "name": "appmixer.quickbooks.accounting.SelectTaxCode",
  "author": "Drew <drew@quoterite.com>",
  "icon": "data:image/svg+xml;base64,",
  "description": "Select a tax code from Quickbooks.",
  "version": "1.0.3",
  "auth": {
    "service": "appmixer:quickbooks"
  },
  "inPorts": [
    {
      "name": "in",
      "schema": {
        "type": "object",
        "properties": {
          "taxCode": { "type": "string" }
        },
        "required": ["taxCode"]
      },
      "inspector": {
        "inputs": {
          "taxCode": {
            "type": "select",
            "label": "Tax Code",
            "index": 1,
            "source": {
              "url": "/component/appmixer/quickbooks/accounting/GetTaxCodes?outPort=out",
              "data": {
                "transform": "./transformers#taxCodesToSelectArray"
              }
            }
          }
        }
      }
    }
  ],
  "outPorts": [
    {
      "name": "out",
      "options": [
        {
          "label": "Tax Code ID",
          "value": "taxCodeId",
          "schema": {
            "type": "string",
            "example": "10"
          }
        }
      ]
    }
  ]
}
